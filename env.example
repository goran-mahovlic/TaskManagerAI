# TaskManagerAI — primjer konfiguracije.
# Kopiraj u `.env` i popuni. `.env` je u .gitignore i nikad ne ide u repozitorij.
#
#   cp env.example .env
#
# Sve je neobavezno: bez ijedne postavke sustav radi na zadanim vrijednostima.

# ── Osnovno ────────────────────────────────────────────────────────────────
# Vrata na kojima sluša web sučelje i API.
TM_PORT=17781

# Vrata koja korisnik upisuje u preglednik. Razlikuju se od TM_PORT samo ako
# poslužitelj radi u kontejneru s preslikanim vratima.
TM_EXTERNAL_PORT=17781

# Ime ili adresa poslužitelja koja se ispisuje u sučelju i u pozdravnoj poruci.
TM_EXTERNAL_HOST=localhost

# Mapa s bazom i radnim datotekama. Zadano: $HOME/.taskmanager
# TM_HOME=/var/lib/taskmanager

# ── Neobavezno: RAG (semantičko pretraživanje znanja) ─────────────────────
# Bez ovih postavki RAG je isključen, a sve ostalo radi normalno.
# TM_CHROMA_HOST=127.0.0.1
# TM_CHROMA_PORT=8000
# TM_OLLAMA_URL=http://127.0.0.1:11434

# ── Neobavezno: dodatni moduli ────────────────────────────────────────────
# Putanje do vlastitih modula za zapisivanje događaja i reviziju. Ako nisu
# postavljene, ploča jednostavno prikazuje prazne brojke.
# TM_OBSERVABILITY_MODULE=/put/do/ObservabilityLogger.ts
# TM_AUDIT_MODULE=/put/do/AuditLogger.ts

# ── Neobavezno: vanjska skripta za upravljanje servisima ──────────────────
# Radni direktorij iz kojega se pokreću naredbe za start i stop servisa.
# TM_SERVICES_DIR=/put/do/mojih/skripti
