# Instanca profila „upravitelj-cvora" — vrijednosti koje se razlikuju po čvoru (ADR-0004 §3).
# NISU tajne, ali NISU ni dio paketa: kopiraj u $TM_HOME/config/profil.instanca.env na čvoru
# (i drži kopiju na stroju s kojeg postavljaš čvorove). Tajne ovdje NE idu — v.
# docs/PROFIL_CVORA_TAJNE.md.
#
#   cp profili/upravitelj-cvora/instanca.primjer.env ~/.taskmanager/config/profil.instanca.env
#
# Popis (JSON polje) piše se kao JSON u jednom retku: ["a","b"].

# ── Obavezno ──────────────────────────────────────────────────────────────────
CVOR_IME=cvor-b
# Imena/adrese pod kojima se ploči pristupa (TM_ALLOWED_HOSTS), zarezom.
CVOR_DOPUSTENI_HOSTOVI=10.0.0.11,cvor-b
# Grupa u koju idu obavijesti i u kojoj bot razgovara (ID GRUPE, ne korisnika — negativan broj).
TG_CHAT_ID=-1000000000000
# Chatovi s kojih bot prima poruke (ID-evi chatova, NE korisnički ID-evi — kvar s prvog čvora).
TG_DOPUSTENI_CHATOVI=["-1000000000000"]
# Ime bota u identitetu i za prepoznavanje obraćanja.
RAZGOVOR_IME=Upravitelj
# Tko smije razgovarati bez prozivke i dobiti ovlasti iznad „citanje": brojčani ID ili korisničko ime.
RAZGOVOR_DOPUSTENI_KORISNICI=["100000001","vlasnik"]
# Hindsight banka OVOG čvora — svaki čvor ima svoju (ne dijeliti s drugim čvorom).
MEMORIJA_BANKA=banka_cvor_b
# Tko dobiva zadatak otvoren iz chata kad ga ništa drugo ne odredi (id iz registra agenata).
ZADANI_IZVRSITELJ=inzenjer

# ── Neobavezno ────────────────────────────────────────────────────────────────
# Riječi/imena zbog kojih bot samo čita (drugi bot, ljudi kojima se obraća netko drugi).
RAZGOVOR_PRESKOCI_AKO_SADRZI=["@drugi_bot"]
# Prazno = zasebna mapa po chatu ($TM_HOME/data/razgovor/radni).
RAZGOVOR_RADNI_DIR=
# Kanal bot↔bot (ADR-0003). Bez BOTKANAL_ADRESE modul ostaje isključen.
BOTKANAL_ADRESE=
BOTKANAL_CHATOVI=[]
BOTKANAL_DRUGI=[]
BOTKANAL_STOP_KORISNICI=[]
# Mapa izvornog sustava na čvoru (baza, registar agenata, modeli). Prazno = paket bez njega.
SUSTAV_DIR=
# HOME stroja s kojeg su datoteke izvornog sustava kopirane — ne smije se pojaviti na čvoru.
TUDI_HOME=
# Referentni sha256 kuke SecurityValidator iz kompleta izvornog sustava (prazno = samo postoji).
SECURITYVALIDATOR_SHA256=

# ── Paritet s glavnim sustavom (ADR-0004 §13) ────────────────────────────────
# Prekidači koje OVAJ čvor drži isključenima (smije bilo koji — oprezniji čvor), JSON popis.
# Npr. dok red nije očišćen: ["staleWatchdogLive","deadAgentReaperLive","zombieRecoveryLive"]
ZNACAJKE_ISKLJUCI=[]
# Prekidači s odlukom „uvjetno" koje ovaj čvor uključuje (npr. ["projectGitInit"]). „van" se ne uključuje.
ZNACAJKE_UKLJUCI=[]
# Paketi kuka: jezgra je uvijek; pai-ucenje = kuke učenja iz kompleta izvornog sustava.
KUKE_PAKETI=jezgra

# ── Znanje čvora (ADR-0006, TASK-5331) ───────────────────────────────────────
# Kako se vlasnik zove u korpusu čvora (uloga, ne ime osobe).
VLASNIK_ULOGA_IME=vlasnik
# Misija banke (prazno = zadana: opći REGOČ + ovaj čvor).
MEMORIJA_MISIJA=
# Dnevni razgovori Telegrama čvora u banku: off | shadow (samo na disk čvora) | on.
ZNANJE_RAZGOVOR=shadow
