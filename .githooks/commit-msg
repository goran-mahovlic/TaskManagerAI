#!/usr/bin/env bash
# commit-msg — vratar identiteta commita (TASK-4723).
#
# Povod (vlasnik, 06.09.2026.): commit 241aa89 je otišao na javni GitHub s
#   Author/Committer: identitet orkestratora
#   Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
# dok svi ostali commiti istog dana nose vlasnikov identitet bez ijednog traga o alatu. Commit se radi rukom (scripts/uskladi_s_regocem.sh ne
# commita), pa je dovoljno da jedan agent ne prepiše zadani identitet harnessa —
# pamćenje nije mehanizam. Ovo jest: git odbija commit prije nego nastane.
#
# Aktivacija u svakom klonu (`.git/hooks` NIJE dio `git clone`):
#     git config core.hooksPath .githooks
#
# Dopušteni autori/committeri — zarezom odvojen popis, SAMO iz git configa:
#     git config taskmanagerai.dopusteniAutori "ja@example.com,drugi@example.com"
# Bez tog popisa (svjež klon) identitet se ne provjerava; trag alata se provjerava uvijek.
# TASK-5109: ovdje je bila NAŠA adresa kao jedini zadani autor, a `scripts/install.sh`
# uključuje ove kuke u svakom klonu — svakom drugom korisniku git je odbijao svaki commit.
set -uo pipefail

PORUKA="$1"

crveno() { printf '\033[31m%s\033[0m\n' "$1" >&2; }

# ── 1. Trag alata u poruci ────────────────────────────────────────────────────
# Komentirani redci ispadaju jer ih git ionako reže prije spremanja commita —
# da hook ne odbija ono što u konačnoj poruci neće ni postojati.
TIJELO="$(grep -v '^[[:space:]]*#' "$PORUKA" || true)"

if printf '%s' "$TIJELO" | grep -qiE 'co-authored-by.*claude'; then
  crveno "commit-msg: ODBIJENO — poruka sadrži 'Co-Authored-By: ... Claude'."
  crveno "  CLAUDE.md: trag alata NIKAD ne ide u povijest ovog repozitorija."
  crveno "  Makni taj redak iz poruke i ponovi commit."
  exit 1
fi

if printf '%s' "$TIJELO" | grep -qiF 'noreply@anthropic.com'; then
  crveno "commit-msg: ODBIJENO — poruka sadrži 'noreply@anthropic.com'."
  crveno "  Makni taj redak iz poruke i ponovi commit."
  exit 1
fi

# ── 2. Identitet autora i committera ──────────────────────────────────────────
# `git var` već uvažava GIT_AUTHOR_EMAIL / GIT_COMMITTER_EMAIL, pa hvata i
# identitet podmetnut kroz okolinu, ne samo onaj iz `git config`.
adresa() { git var "$1" 2>/dev/null | sed -n 's/.*<\(.*\)>.*/\1/p'; }

DOPUSTENI="$(git config --get taskmanagerai.dopusteniAutori || true)"
[ -n "$(printf '%s' "$DOPUSTENI" | tr -d '[:space:],')" ] || exit 0

dopusten() {
  local trazena="$1" e
  IFS=',' read -ra POPIS <<< "$DOPUSTENI"
  for e in "${POPIS[@]}"; do
    e="$(printf '%s' "$e" | tr -d '[:space:]')"
    [ -n "$e" ] && [ "$e" = "$trazena" ] && return 0
  done
  return 1
}

for ULOGA in AUTHOR COMMITTER; do
  EMAIL="$(adresa "GIT_${ULOGA}_IDENT")"
  if ! dopusten "$EMAIL"; then
    crveno "commit-msg: ODBIJENO — ${ULOGA,,} je '$EMAIL', a dopušteni su: $DOPUSTENI"
    crveno "  Ispravi identitet (git config user.name / user.email) na jednog od dopuštenih."
    crveno "  Ako je ovaj identitet namjeran, dodaj ga izričito:"
    crveno "    git config taskmanagerai.dopusteniAutori '$DOPUSTENI,$EMAIL'"
    exit 1
  fi
done

exit 0
