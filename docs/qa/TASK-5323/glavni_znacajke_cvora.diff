+#!/usr/bin/env bash
+# gradi_komplet.sh — komplet izvornog sustava glavnog stroja za čvor (TASK-5323, ADR-0004 P5).
+#
+# Teret = (a) svi moduli u korijenu ~/.claude/regoc (*.ts, bez .bak) — to mjeri paritet.py,
+#         (b) zatvorenje uvoza ulaza daemona i alata koje daemon pokreće (bun build --metafile),
+#             uključivo tools/rag/lib (rag-gate; ~/.claude/skills/CORE/Tools/lib je poveznica na nju),
+#             models/, tools/hindsight …, i TaskManagerMD/src/IngestGateConfig.ts (jedini uvoz iz ploče),
+#         (c) poveznice tools/<ime>.ts → tools/<mapa>/<ime>.ts koje daemon zove po staroj putanji,
+#         (d) postavke config/*.json koje čvor NEMA (isporuka ih ne prepisuje — cp -n na čvoru),
+#         (e) mjerilo potrošnje session_usage.py (TASK-4777: bez njega su vrata autonomije fail-open).
+# NE ide: data/, features.json, ostatak TaskManagerMD/ (čvor vozi ploču paketa), *.bak*, daemon.env i
+# telegram-identity.json i postavke s putanjama glavnog stroja (/home/klaudio), node_modules.
+# Brana: datoteka s oblikom tajne ruši gradnju (exit 5).
+#   bash gradi_komplet.sh            # gradi payload/ + MANIFEST.sha256
+set -euo pipefail
+R="$HOME/.claude/regoc"
+OVDJE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+TERET="$OVDJE/payload"
+RAD="$(mktemp -d "${TMPDIR:-$HOME/app/tmp}/komplet.XXXXXX")"
+trap 'rm -rf "$RAD"' EXIT
+export PATH="$HOME/.bun/bin:$PATH"
+
+ULAZI=(RegocDaemon.ts AgentDaemon.ts AgentWorker.ts StaleCodeCheck.ts
+       tools/modeli/ollama-agent.ts tools/modeli/openrouter-agent.ts tools/orkestracija/adversarial-provjeri.ts
+       tools/zadaci/checkpoint.ts tools/modeli/consult-potjeh.ts)
+POVEZNICE=(tools/ollama-agent.ts tools/openrouter-agent.ts tools/adversarial-provjeri.ts tools/checkpoint.ts tools/consult-potjeh.ts)
+CONFIG_IZUZETI='daemon.env|telegram-identity.json'
+
+popis="$RAD/popis.txt"; : > "$popis"
+cd "$R"
+for u in "${ULAZI[@]}"; do
+  bun build "$u" --target=bun --outdir="$RAD/out" --metafile="$RAD/meta.json" >/dev/null
+  python3 - "$RAD/meta.json" "$R" >> "$popis" <<'PY'
+import json, os, sys
+meta, R = sys.argv[1], sys.argv[2]
+home = os.path.dirname(os.path.dirname(R))          # ~
+for p in json.load(open(meta))['inputs']:
+    a = os.path.realpath(os.path.join(R, p))
+    if '/node_modules/' in a or not a.startswith(home + '/.claude/'):
+        continue
+    print(os.path.relpath(a, home))                  # .claude/regoc/… ili .claude/skills/…
+PY
+done
+ls *.ts | grep -v '\.bak' | sed 's|^|.claude/regoc/|' >> "$popis"
+sort -u "$popis" -o "$popis"
+
+rm -rf "$TERET"; mkdir -p "$TERET"
+while read -r f; do
+  mkdir -p "$TERET/$(dirname "$f")"; cp -p "$HOME/$f" "$TERET/$f"
+done < "$popis"
+for l in "${POVEZNICE[@]}"; do
+  mkdir -p "$TERET/.claude/regoc/$(dirname "$l")"
+  ln -sfn "$(readlink "$R/$l")" "$TERET/.claude/regoc/$l"
+done
+mkdir -p "$TERET/.claude/regoc/config.novo"
+for c in "$R"/config/*.json; do
+  b="$(basename "$c")"; echo "$b" | grep -qE "$CONFIG_IZUZETI" && continue
+  grep -q '/home/klaudio' "$c" && continue      # putanje/projekti glavnog stroja ne idu na čvor
+  cp -p "$c" "$TERET/.claude/regoc/config.novo/$b"
+done
+mkdir -p "$TERET/app/regoc_system/tools"
+cp -p "$HOME/app/regoc_system/tools/session_usage.py" "$TERET/app/regoc_system/tools/"
+
+# Brana tajni: oblik ključa/tokena u teretu ruši gradnju.
+if grep -rIlE 'sk-ant-[A-Za-z0-9_-]{20}|[0-9]{8,10}:AA[A-Za-z0-9_-]{30}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY' "$TERET"; then
+  echo "❌ oblik tajne u teretu — gradnja prekinuta" >&2; exit 5
+fi
+
+cd "$OVDJE"
+find payload -type f | LC_ALL=C sort | xargs sha256sum > MANIFEST.sha256
+echo "✅ komplet: $(find payload -type f | wc -l) datoteka, $(find payload -type l | wc -l) poveznica; MANIFEST.sha256 $(wc -l < MANIFEST.sha256) redaka"
