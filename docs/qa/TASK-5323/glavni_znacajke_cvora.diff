+/**
+ * TASK-5323 — značajke koje su postojale samo na node-A (ADR-0004 §13.8) ožičene u ŽIVI izvor
+ * glavnog sustava, da puni komplet (deploy_node_a.sh) čvoru ništa ne oduzme:
+ *   ragUkljucen (TASK-5273), paketKanal (TASK-5285), anti-kaskada TASK-255.
+ * (provider@čvor:model je u glavnom već u models/AgentModel.ts — resolveAgentTarget.)
+ * Čista pravila su u paket-kanal / spawn-slot-rules / agent-routing testovima.
+ */
+import { describe, test, expect } from 'bun:test'
+import { readFileSync } from 'fs'
+import { join } from 'path'
+
+const R = join(process.env.HOME || '', '.claude/regoc')
+const daemon = readFileSync(join(R, 'RegocDaemon.ts'), 'utf8')
+const rag = readFileSync(join(R, 'RagCollections.ts'), 'utf8')
+const agentModel = readFileSync(join(R, 'models/AgentModel.ts'), 'utf8')
+
+function tijelo(src: string, potpis: string): string {
+  const i = src.indexOf(potpis)
+  expect(i).toBeGreaterThan(-1)
+  return src.slice(i, src.indexOf('\n}\n', i))
+}
+
+describe('ragUkljucen (TASK-5273)', () => {
+  test('daemon i RagCollections uvoze prekidač', () => {
+    expect(daemon).toContain("import { ragUkljucen } from '../skills/CORE/Tools/lib/rag-gate'")
+    expect(rag).toContain("import { ragUkljucen } from '../skills/CORE/Tools/lib/rag-gate'")
+  })
+  test('queryRAG ne spawna rag-query kad je RAG isključen', () => {
+    expect(tijelo(daemon, 'async function queryRAG(')).toMatch(/if \(!ragUkljucen\(\)\) return ''/)
+  })
+  test('spremanje konteksta u RAG, blok memorije i uputa kolekcija traže prekidač', () => {
+    expect(daemon).toMatch(/currentContextPct >= CONTEXT_THRESHOLD_PCT && !contextAlreadySavedThisSession && ragUkljucen\(\)/)
+    expect(daemon).toMatch(/if \(isEnabled\('agentIdentityBlock'\) && ragUkljucen\(\)\) \{\s*\n\s*try \{\s*\n\s*\/\/ R1c\/TASK-4602/)
+    expect(daemon).toMatch(/if \(effectiveHints\.length > 0 && ragUkljucen\(\)\)/)
+  })
+  test('upute u promptu bez RAG-a upućuju na datoteke', () => {
+    expect(daemon.match(/[Nn]a ovom čvoru NEMA RAG-a/g)?.length).toBeGreaterThanOrEqual(2)
+  })
+  test('start daemona ne dira ChromaDB bez RAG-a', () => {
+    expect(daemon).toContain("if (!ragUkljucen()) log('📚 RAG isključen na ovom čvoru")
+  })
+  test('RagCollections: dohvat i popis kolekcija preskaču mrežu', () => {
+    expect(rag.match(/if \(!ragUkljucen\(\)\) return/g)?.length).toBe(2)
+  })
+})
+
+describe('paketKanal (TASK-5285)', () => {
+  test('token: datoteka stroja pa paket', () => {
+    expect(tijelo(daemon, 'function getTelegramToken(')).toContain('tokenKanala(_telegramTokenIzDatoteke(), paketKanal)')
+  })
+  test('flush: chat i stil iz kanala paketa kad je paket izvor', () => {
+    expect(daemon).toContain('const _pk = kanalJePaketov() ? paketKanal() : null')
+    expect(daemon).toContain('chatZaPoruku(msg.chat_id, _pk, REGOC_GROUP_FALLBACK)')
+    expect(daemon).toContain('(_pk ? _pk.oblikuj(String(msg.content)) : String(msg.content))')
+  })
+})
+
+describe('anti-kaskada TASK-255', () => {
+  test('createSequentialHelpers predaje izvor zadatka pravilu lanca', () => {
+    const b = tijelo(daemon, 'async function createSequentialHelpers(')
+    expect(b).toContain('createdBy: primaryCreatedBy')
+  })
+  test('auto-exec predaje createdBy zadatka', () => {
+    expect(daemon).toMatch(/createSequentialHelpers\(content, agentId, task\.id, task\.projectId \|\| undefined, parentChatTag \|\| null, task\.tags, \(task as any\)\.createdBy\)/)
+  })
+  test('tim lanac: E1/E2 bez tima', () => {
+    expect(tijelo(daemon, 'async function createSequentialHelpers(')).toContain('timPoNaporu(cls.effort)')
+  })
+})
+
+describe('provider@čvor:model', () => {
+  test('glavni već razrješava provider[@node]:model', () => {
+    expect(agentModel).toContain("const at = head.indexOf('@')")
+    expect(daemon).toContain('providers?.ollama?.nodes?.[node]')
+  })
+})
