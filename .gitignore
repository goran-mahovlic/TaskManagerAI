# ── Tajne ──────────────────────────────────────────────────────────────────
# Ništa od ovoga ne smije završiti u repozitoriju.
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*
*token*

# ── Podatci ────────────────────────────────────────────────────────────────
# Baza se stvara skriptom scripts/init-db.sh, ne prenosi se kroz git.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Radne datoteke ─────────────────────────────────────────────────────────
node_modules/
dist/
build/
*.log
logs/
tmp/
.tmp/
*.pid
*.lock
!bun.lock

# ── Interni alati održavanja (ROADMAP_SAMOSTALNOST §5) ─────────────────────
# Skripta koja prenosi izmjene IZ žive instalacije U paket. Korisniku koji nema
# tu instalaciju ne znači ništa, a otkriva unutarnji raspored privatnog sustava.
# Ostaje lokalno, izvan git indeksa (`git rm --cached`, 10.09.2026., TASK-4800).
scripts/uskladi_s_regocem.sh

# ── Konfiguracija s korisničkim tajnama ────────────────────────────────────
# JSON postavke integracija nastaju pri prvom spremanju s ploče i nose adrese,
# korisnička imena i IMENA varijabli s tajnama. Same tajne idu u credentials.env
# (prava 0600) — ni jedno ni drugo ne ide u repozitorij.
config/telegram.json
config/dezurni.json
config/nextcloud.json
config/email.json
config/gitlab.json
config/github.json
config/orchestrator.json
config/agents.json
# Vrata ulaza (ingest) nisu tajna, ali JESU ziva runtime konfiguracija: `IngestConfig`
# pise upravo ovamo kad `TM_HOME` nije postavljen (zadano), pa svaki pomak prekidaca s
# ploce prlja radno stablo. `projectBySource` uz to nosi kljuceve izvora — za Telegram su
# to id-evi chatova. Isporucuje se `config/ingest-gate.example.json`.
# (`git rm --cached`, 10.09.2026., revizija TASK-4801 nalaz B4.)
config/ingest-gate.json
config/ingest.json
# Postavke upisa tajni (`scripts/tajna.ts podesi`, TASK-5357): kao nepraćenu datoteku ju je
# `git clean` pri deployu (tm-cvor-azuriraj.sh) brisao s čvora.
config/tajne.json
# Ključ otiska tajni (LoginCreds.kljucOtiskaUz) nastaje uz spremište; u razvojnom stablu je to
# config/ — bez ovog retka `git status` nije prazan nakon prvog `tajna.ts postavi` (QA K6 B4).
config/tajne-otisak.kljuc
config/credentials.env

# ── Uređivači i sustav ─────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
__pycache__/
*.pyc
config/postavke.env
# Granica repozitorij ↔ čvor (plan Mac v2 P4.1, TASK-5658): lokalne postavke i vjerodajnice
# žive samo u $TM_HOME/config; u repozitoriju su samo primjeri bez vrijednosti (*.primjer*).
*.env
!*.primjer.env
config/memorija.json
vjerodajnice*
*.local.*
# Vratari zatvaranja: živa postavka po instalaciji; isporučuju se *.example.json.
config/step-schema.json
config/completion-gate.json
config/critic-gate.json
config/features.json
config/energija.json
config/rag-backend.json

# Zakrpe za živu instalaciju (interni raspored mapa) — ne idu u paket (TASK-5108).
scripts/zakrpe/
# Konfiguracija koju upisuje instalacija ili ploča (TASK-5108: čita se kroz konfigPutanja).
config/REGOC_AGENTS.json
config/model-config.json
config/module-config.json
config/odlucitelj.json
config/workflow-gate.json
config/memory-config.json
config/stale-watchdog.json
config/uvoz-telegrama.json
# Jednokratni interni alati (naši projekti, kolekcije i ljudi u kodu) — žive u repozitoriju
# sustava, ne u paketu (TASK-5108, kao scripts/uskladi_s_regocem.sh).
tools/rag_audit.py
tools/razvrstaj_pretinac.py
tools/razvrstaj_prijave.py

# ── Glasovni model (TASK-5340) ─────────────────────────────────────────────
# hr_regoc je privatan: dolazi uz scripts/instaliraj-glas.sh --model-izvor, ne kroz git.
*.onnx
*.onnx.json

# ── Komplet izvornog sustava (TASK-5705, D3 = B) ───────────────────────────
# regoc-system/ je izvoz koji je prošao brane (gradi_komplet.sh --javno) i ima MANIFEST.sha256 —
# pravila gore (npr. *secret*, *token*, data/) ne smiju iz njega ispustiti nijednu datoteku, inače
# klon paketa nema cijeli komplet i `install.sh --komplet` pada na manifestu. Što komplet sam ne
# prati (node_modules/, config/, data/ …) kaže njegov regoc-system/.gitignore.
!/regoc-system/**
