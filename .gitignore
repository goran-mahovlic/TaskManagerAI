# ── Tajne ──────────────────────────────────────────────────────────────────
# Ništa od ovoga ne smije završiti u repozitoriju.
.env
.env.*
!.env.example
*.key
*.pem
*credentials*
*secret*
*token*

# ── Podatci ────────────────────────────────────────────────────────────────
# Baza se stvara skriptom scripts/init-db.sh, ne prenosi se kroz git.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

